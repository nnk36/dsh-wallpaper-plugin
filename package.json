{
  "name": "dsh-wallpaper",
  "version": "0.1.1",
  "private": true,
  "description": "DSH Web 背景底图：在设置里上传图片更换界面底图，可一键恢复默认空白底图；底图落盘，刷新与 DSH 重启后自动生效",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "background"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
